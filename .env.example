# Export variables in your shell; .env is a reference, not automatically loaded.
RADAR_DATABASE_URL=sqlite:///./data/radar.db
# Single-owner private application: bind to loopback or use a private tunnel.

# Discovery remains local/fixture by default. .env is not loaded automatically.
EBAY_MODE=fixture
EBAY_SOURCE_ENABLED=true
# Configure real credentials securely in environment settings, never in this file.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Fixture defaults remain safe. JRI-011 developer approval is owner-reported;
# live Browse still needs usable Production credentials, network access and run consent.
EBAY_PRODUCTION_ENABLED=false
EBAY_PRODUCTION_APPROVED=false

# Vision stays free/fixture until separately enabled and confirmed per request.
VISION_PROVIDER=fixture
VISION_LIVE_ENABLED=false
# Optional first Haiku pilot: one lifetime paid attempt, only after browser confirmation.
# Keep general provider fixture/live false. Never enable this for routine operation.
VISION_PILOT_ONE_SHOT=false
VISION_MODEL=claude-haiku-5-5
VISION_DEEP_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
VISION_DAILY_LIMIT=10
VISION_MONTHLY_BUDGET_USD=5.00
# Optional private image directory; never point it at public static storage.
# VISION_IMAGE_DIR=/private/path

# Unattended scheduler (python -m radar.scheduler). This file IS loaded by the scheduler.
# RADAR_SCHEDULE_HOURS=1
# RADAR_DAILY_CALL_LIMIT=4000
# RADAR_QUERIES=fixtures/seed_queries.json
# RADAR_PAGE_SIZE=50
# RADAR_PAGES_PER_QUERY=1

# Vision triage (runs after each scheduler cycle; python -m radar.triage run|status)
# ANTHROPIC_API_KEY=sk-ant-...
# VISION_MODEL=claude-haiku-5-5
# VISION_DAILY_BUDGET_USD=1.00
# VISION_TRIAGE_ENABLED=true

# Value read is derived from the walk-away economics (RADAR_MARGIN_TIERS / RADAR_FEE_*):
# UNDERPRICED = landed <= walk-away at resale low; FAIR = <= walk-away at resale midpoint.

# Notifications (digest after each cycle; nothing sent on a quiet cycle)
# RADAR_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# RADAR_NTFY_TOPIC=
# RADAR_NOTIFY_MIN_SCORE=75
# RADAR_NOTIFY_ENDING_HOURS=2
# RADAR_PUBLIC_URL=http://radar:8000

# Alerts mailbox (polled each cycle; python -m radar.mailbox test|poll|status)
RADAR_IMAP_HOST=imap.gmail.com
RADAR_IMAP_USER=
RADAR_IMAP_PASSWORD=

# Marketplace adapters (run each cycle over the seed queries when configured)
# ETSY_API_KEY=            # keystring from etsy.com/developers (active once the app is approved)
# ETSY_SHARED_SECRET=      # "shared secret" from the same app page; Etsy requires both
# ETSY_SHOP_LOCATION=United States
# ETSY_QUERIES=            # unset = a short built-in list; "all" = every seed term
# VISION_MAX_PER_CYCLE=600 # most listings screened in one cycle; a backlog spreads out
# BONANZA_QUERIES=         # unset = a short built-in list; "all" = every seed term
# RADAR_IMAP_TIMEOUT=60
# BONANZA_DEV_NAME=
# BONANZA_CERT_NAME=

# Queue / auto-archive
# RADAR_QUEUE_MIN_SCORE=80        # queue = NEW + relevant + UNDERPRICED + score >= this + not ended
# RADAR_STALE_DAYS=7              # undecided Buy-It-Now items older than this are archived
# RADAR_NOTIFY_MAX_ITEMS=10       # finds listed per Slack digest
# RADAR_PURGE_DAYS=14             # delete ended/archived listings after this many days (0 = never)

# Walk-away price (owner economics shown on each card)
# RADAR_MARGIN_TIERS=100:0.50,500:0.35,inf:0.25   # target margin by expected sale price
# RADAR_FEE_COMMISSION=0.08                        # Whatnot commission below the threshold
# RADAR_FEE_COMMISSION_FREE_ABOVE=1500
# RADAR_FEE_PROCESSING=0.029
# RADAR_FEE_FIXED=0.30

# Deep pass (queue items only: all photos + description, tighter resale range, comp query, hallmark read)
# VISION_DEEP_MODEL=claude-sonnet-5-5
# VISION_DEEP_DAILY_BUDGET_USD=1.50
# VISION_DEEP_IMAGES=6
# VISION_DEEP_ENABLED=true

# eBay category sweep (no keywords: everything filed under Ethnic, Regional & Tribal Jewelry
# with the chosen "Ethnic & Regional Style"; empty disables)
# RADAR_CATEGORY_SWEEP=Native American,Southwestern,Mexican
# RADAR_CATEGORY_SWEEP_LIMIT=200
# RADAR_OFFER_MAX_DISCOUNT=0.30   # queue Best Offer listings whose walk-away is within this of asking
# RADAR_HERO_MIN_SCORE=60   # score floor for the Statement / hero tab
# RADAR_FAST_MINUTES=5      # newest-listings check between full cycles; 0 turns it off
# RADAR_PICKUP_RATE=0.05        # share of the price paid to whoever collects a pickup lot
# RADAR_FORWARD_POSTAGE=12      # estimated postage to forward a small insured parcel to Alaska
# RADAR_AUCTION_HORIZON_HOURS=48   # plain auctions enter the queue this close to ending
# RADAR_NOTIFY_AUCTION_HOURS=1     # plain auctions are alerted only this close to ending
# RADAR_FOREIGN_MARKETS=EBAY_DE,EBAY_GB   # other eBay sites searched hourly; empty = off
# RADAR_IMPORT_RATE=0.15                  # duty allowance on purchases from abroad
# RADAR_FX_EUR=  RADAR_FX_GBP=            # USD per unit; overrides the ECB daily rate
# RADAR_SHOP_FEEDS=https://turquoisetraders.com   # Shopify stores whose product feed is read
