# Replace the example host only after the owner supplies an owned domain and approves deployment.
{
	log {
		# Default HTTP error events include request headers and challenge query strings.
		# Drop request-bearing logs; monitor aggregate receiver/service/backup status instead.
		exclude http.log.error http.log.access
	}
}
ebay-notify.example.invalid {
	@notification path /ebay/account-deletion
	handle @notification {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:8091
	}
	handle {
		respond 404
	}
	# Do not enable access/body/header logs: challenge query strings are private.
}
