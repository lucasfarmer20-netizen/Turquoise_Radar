# On host: /etc/ebay-receiver/receiver.env, root-owned mode 0600. Never commit real values.
EBAY_DELETION_ENDPOINT=https://ebay-notify.example.invalid/ebay/account-deletion
# Generate each independently with Python secrets.token_urlsafe(48), outside logs/chat.
EBAY_DELETION_VERIFICATION_TOKEN=REPLACE_WITH_32_TO_80_URL_SAFE_CHARACTERS
EBAY_DELETION_HMAC_KEY=REPLACE_WITH_INDEPENDENT_HIGH_ENTROPY_KEY
EBAY_DELETION_QUEUE=/var/lib/ebay-receiver/queue.db
# Matching Production keyset, dedicated to signature key lookup. Not Browse enablement.
EBAY_NOTIFICATION_CLIENT_ID=REPLACE_SECURELY
EBAY_NOTIFICATION_CLIENT_SECRET=REPLACE_SECURELY
